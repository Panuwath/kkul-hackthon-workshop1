{
  "name": "pema-kku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "node scripts/prisma-with-env.mjs validate",
    "db:migrate": "node scripts/prisma-with-env.mjs migrate deploy",
    "db:dev": "node scripts/prisma-with-env.mjs migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "deploy:server": "bash scripts/deploy-server.sh"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "clsx": "^2.1.1",
    "jose": "6.2.10",
    "lucide-react": "^0.453.0",
    "next": "16.3.3",
    "prisma": "6.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
