# Runtime
APP_ENV=development
APP_PORT=3061
RUN_MIGRATIONS=false

# Database: either provide DATABASE_URL or the existing DB_* values.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=pema
DB_USERNAME=pema
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Auth: dev headers work only when APP_ENV is not production.
AUTH_MODE=dev
AUTH_JWT_SECRET=

# Optional application URL used by reverse proxy/deployment documentation.
APP_BASE_URL=http://localhost:3061

# Browser API base path. The production reverse proxy serves the app under /pema.
NEXT_PUBLIC_API_BASE_URL=/pema/api
# Dev-only identity headers; production uses JWT and never sends these headers.
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_AUTH_ROLE=STAFF
