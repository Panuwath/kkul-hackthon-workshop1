generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
  FINANCE
  DIRECTOR
  DEAN
  VICE_RECTOR
  RECTOR
  ADMIN
}

enum RequestStatus {
  DRAFT
  PENDING_FINANCE
  PENDING_DIRECTOR
  PENDING_DEAN
  PENDING_VICE_RECTOR
  PENDING_RECTOR
  FULLY_APPROVED
  RETURNED
  CANCELLED
}

enum DisbursementStatus {
  DRAFT
  PENDING_FINANCE
  APPROVED
  RETURNED
  CANCELLED
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  users     User[]
  requests  ExpenseRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id              String          @id @default(cuid())
  externalId      String          @unique
  email           String?         @unique
  name            String
  role            UserRole        @default(STAFF)
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  createdRequests ExpenseRequest[] @relation("CreatedRequests")
  approvalEvents  ApprovalEvent[] @relation("ApprovalActors")
  disbursements   Disbursement[]  @relation("DisbursementCreators")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([role])
  @@index([departmentId])
}

model ExpenseRequest {
  id                   String          @id @default(cuid())
  requestNo            String          @unique
  projectName          String
  projectType          String
  organizerDepartment String
  contactPhone         String?
  startDate            DateTime
  endDate              DateTime
  location             String
  venueType            String
  participants         Int
  attendanceFeeMode    String
  inPlan               Boolean?
  isContinuing         Boolean?
  strategicIssue       String?
  rationale            String?
  objectives           String?
  targetGroup          String?
  expectedOutcome      String?
  successIndicator     String?
  grandTotal           Decimal         @default(0) @db.Decimal(14, 2)
  status               RequestStatus   @default(DRAFT)
  version              Int             @default(1)
  createdById          String
  createdBy            User            @relation("CreatedRequests", fields: [createdById], references: [id])
  departmentId         String?
  department            Department?    @relation(fields: [departmentId], references: [id])
  items                ExpenseItem[]
  sessions             TrainingSession[]
  attachments          Attachment[]
  approvalEvents       ApprovalEvent[]
  disbursements        Disbursement[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([createdById, status])
  @@index([status, updatedAt])
  @@index([organizerDepartment])
}

model ExpenseItem {
  id          String         @id @default(cuid())
  requestId   String
  request     ExpenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category    String
  description String?
  quantity    Decimal        @db.Decimal(12, 2)
  unit        String
  unitPrice   Decimal        @db.Decimal(14, 2)
  amount      Decimal        @db.Decimal(14, 2)
  isV119      Boolean        @default(false)
  isContracted Boolean       @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([requestId])
}

model TrainingSession {
  id          String         @id @default(cuid())
  requestId   String
  request     ExpenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  topic       String
  type        String
  hours       Decimal        @db.Decimal(5, 2)
  groupCount  Int?
  totalAmount Decimal        @default(0) @db.Decimal(14, 2)
  speakers    Speaker[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([requestId])
}

model Speaker {
  id          String          @id @default(cuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  speakerType String
  isSpecial   Boolean         @default(false)
  hourlyRate  Decimal         @db.Decimal(14, 2)
  amount      Decimal         @db.Decimal(14, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sessionId])
}

model Attachment {
  id          String         @id @default(cuid())
  requestId   String
  request     ExpenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  label       String
  fileName    String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime       @default(now())

  @@index([requestId])
}

model ApprovalEvent {
  id          String         @id @default(cuid())
  requestId   String
  request     ExpenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User           @relation("ApprovalActors", fields: [actorId], references: [id])
  action      String
  fromStatus  RequestStatus?
  toStatus    RequestStatus?
  reason      String?
  requestIdRef String?
  createdAt   DateTime       @default(now())

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

model RateCatalog {
  id          String   @id @default(cuid())
  code        String
  label       String
  fiscalYear  Int
  maxRate     Decimal  @db.Decimal(14, 2)
  unit        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, fiscalYear])
  @@index([isActive, fiscalYear])
}

model Disbursement {
  id          String             @id @default(cuid())
  requestId   String
  request     ExpenseRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  number      String             @unique
  amount      Decimal            @db.Decimal(14, 2)
  note        String?
  status      DisbursementStatus @default(DRAFT)
  createdById String
  createdBy   User               @relation("DisbursementCreators", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([requestId])
  @@index([status, updatedAt])
}
